# ElevenGov — Environment Variables
# Copy this file to .env.local and fill in your values

# ElevenLabs API key (server-side only, never expose to client)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID for Dirk (the official EU portal voice)
# Default: Adam voice (pNInz6obpgDQGcFmaJgB) if not set
DIRK_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Public URL of the deployed app (used for canonical links, OG tags, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
